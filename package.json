{
  "name": "agentshelf-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "node --test tests/unit/*.test.mjs && turbo run test",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "licenses:check": "node scripts/licenses.mjs",
    "security:check": "pnpm audit --audit-level low && node scripts/secrets.mjs",
    "build": "tsc --noEmit false --outDir dist/tooling && turbo run build",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@secretlint/core": "13.0.7",
    "@secretlint/secretlint-rule-aws": "13.0.7",
    "@secretlint/secretlint-rule-github": "13.0.7",
    "@secretlint/secretlint-rule-npm": "13.0.7",
    "@secretlint/secretlint-rule-openai": "13.0.7",
    "@secretlint/secretlint-rule-privatekey": "13.0.7",
    "@types/node": "^26.6.4",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
