{
  "name": "agentshelf-workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "node --test tests/unit/*.test.mjs && turbo run test",
    "test:integration": "pnpm build && node --test tests/integration/*.test.mjs",
    "licenses:check": "node scripts/licenses.mjs",
    "security:check": "pnpm audit --audit-level low && node scripts/secrets.mjs",
    "build": "tsc --noEmit false --outDir dist/tooling && turbo run build",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "dev": "pnpm build && node apps/web/dist/main.js",
    "test:e2e": "pnpm build && node --test tests/e2e/*.test.mjs",
    "packages:check": "pnpm build && node scripts/packages.mjs",
    "test:coverage": "pnpm build && node scripts/coverage.mjs",
    "benchmark": "pnpm build && node tests/performance/run.mjs",
    "sbom:generate": "pnpm licenses:check && pnpm sbom --sbom-format cyclonedx --sbom-spec-version 1.6 --out reports/sbom.json"
  },
  "devDependencies": {
    "@agentshelf/api": "workspace:^",
    "@agentshelf/core": "workspace:^",
    "@agentshelf/mcp": "workspace:^",
    "@agentshelf/query-engine": "workspace:^",
    "@agentshelf/schema": "workspace:^",
    "@agentshelf/testing": "workspace:^",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@secretlint/core": "13.0.7",
    "@secretlint/secretlint-rule-aws": "13.0.7",
    "@secretlint/secretlint-rule-github": "13.0.7",
    "@secretlint/secretlint-rule-npm": "13.0.7",
    "@secretlint/secretlint-rule-openai": "13.0.7",
    "@secretlint/secretlint-rule-privatekey": "13.0.7",
    "@types/node": "^24.19.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
