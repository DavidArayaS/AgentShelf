{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": ["scripts/**/*.mjs"]
}
