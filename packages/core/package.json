{
  "name": "@agentshelf/core",
  "version": "0.1.0",
  "description": "AgentShelf core public package",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidArayaS/AgentShelf.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentshelf/schema": "workspace:^",
    "@agentshelf/connector-sdk": "workspace:^",
    "@agentshelf/connector-generic-web": "workspace:^",
    "@agentshelf/connector-woocommerce": "workspace:^",
    "@agentshelf/crawler": "workspace:^",
    "@agentshelf/validators": "workspace:^",
    "@agentshelf/scoring": "workspace:^"
  }
}
