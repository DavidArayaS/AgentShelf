{
  "name": "@agentshelf/protocol-ucp",
  "version": "0.1.0",
  "description": "AgentShelf protocol-ucp public package",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidArayaS/AgentShelf.git",
    "directory": "packages/protocol-ucp"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spec/*": "./spec/*"
  },
  "files": [
    "dist",
    "spec",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@agentshelf/protocol-sdk": "workspace:^",
    "@agentshelf/schema": "workspace:^"
  }
}
